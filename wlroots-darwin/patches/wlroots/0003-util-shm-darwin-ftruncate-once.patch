From 4e3f390dd6e9f69048a13b1d6d851fe783051a0f Mon Sep 17 00:00:00 2001
From: Joel Winarske <joel.winarske@linux.com>
Date: Sun, 19 Jul 2026 09:00:00 -0700
Subject: [PATCH] util/shm: size shm object before reopen (Darwin
 ftruncate-once)

macOS only allows ftruncate() on a POSIX shm object once, right after
creation and before it is reopened or shm_unlink'd. allocate_shm_file_pair
opened the read-only fd and unlinked before ftruncate, so it failed on
Darwin (keymap allocation failed, breaking keyboard input to clients).
Move the ftruncate up to right after creation; correct on Linux too.
---
 util/shm.c | 28 +++++++++++++++++-----------
 1 file changed, 17 insertions(+), 11 deletions(-)

diff --git a/util/shm.c b/util/shm.c
index 5eb87bb..4302561 100644
--- a/util/shm.c
+++ b/util/shm.c
@@ -63,6 +63,19 @@ bool allocate_shm_file_pair(size_t size, int *rw_fd_ptr, int *ro_fd_ptr) {
 		return false;
 	}
 
+	// Size the object now, before any second reference. Darwin only allows
+	// ftruncate() on a POSIX shm object once, right after creation and before
+	// it is reopened or unlinked; doing it here works on Linux too.
+	int ret;
+	do {
+		ret = ftruncate(rw_fd, size);
+	} while (ret < 0 && errno == EINTR);
+	if (ret < 0) {
+		shm_unlink(name);
+		close(rw_fd);
+		return false;
+	}
+
 	// CLOEXEC is guaranteed to be set by shm_open
 	int ro_fd = shm_open(name, O_RDONLY, 0);
 	if (ro_fd < 0) {
@@ -74,22 +87,15 @@ bool allocate_shm_file_pair(size_t size, int *rw_fd_ptr, int *ro_fd_ptr) {
 	shm_unlink(name);
 
 	// Make sure the file cannot be re-opened in read-write mode (e.g. via
-	// "/proc/self/fd/" on Linux)
+	// "/proc/self/fd/" on Linux). Darwin has no /proc and shm objects do not
+	// support fchmod(), so the read-only reopen above is the guarantee there.
+#ifndef __APPLE__
 	if (fchmod(rw_fd, 0) != 0) {
 		close(rw_fd);
 		close(ro_fd);
 		return false;
 	}
-
-	int ret;
-	do {
-		ret = ftruncate(rw_fd, size);
-	} while (ret < 0 && errno == EINTR);
-	if (ret < 0) {
-		close(rw_fd);
-		close(ro_fd);
-		return false;
-	}
+#endif
 
 	*rw_fd_ptr = rw_fd;
 	*ro_fd_ptr = ro_fd;
-- 
2.55.0

