# Pinned upstream sources for the wlroots Darwin port.
# This builds against the libwayland produced by the sibling wayland-darwin
# component in this repo (its install PREFIX is consumed via PKG_CONFIG_PATH).
WLROOTS_URL="https://gitlab.freedesktop.org/wlroots/wlroots.git"
WLROOTS_REF="d64acffc571643e1711361a967e399e0f1a9d5af"   # master @ 0.21.0-dev

# libdrm is cloned only as the source of authoritative uapi/xf86drm headers
# (vendored into the libdrm-compat shim); it is not built.
LIBDRM_URL="https://gitlab.freedesktop.org/mesa/drm.git"
LIBDRM_REF="f9816a42b0d6138851cbe5eb7a33ee1a2f2a15ca"

# wayland-protocols: XML protocol definitions wlroots generates code from.
WAYLAND_PROTOCOLS_URL="https://gitlab.freedesktop.org/wayland/wayland-protocols.git"
WAYLAND_PROTOCOLS_REF="afb614d5fcbd02d261a6ae91920aa91cf3915a8a"  # main (>=1.48)
